# Optional overrides for docker-compose.yml. Copy to `.env` (git-ignored) to use.
# All values have local-only defaults, so the stack boots without this file.
POSTGRES_USER=control_plane
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=control_plane
RABBITMQ_PASSWORD=change-me
API_PORT=8000
RABBITMQ_MGMT_PORT=15672

# Worker simulator behaviour (re-read on `docker compose up -d worker`)
WORKER_FAIL_RATE=0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=2000
WORKER_DUPLICATE_RATE=0
WORKER_REORDER=false
